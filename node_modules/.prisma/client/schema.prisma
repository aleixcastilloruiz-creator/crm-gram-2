// Esquema de datos del motor "Reenviador" de LUXE FAN MANAGEMENT
// Diseño propio (no copiado de ningún producto de terceros): cubre el mismo
// conjunto de funcionalidad de negocio (multi-cuenta, multi-campaña, modo
// aleatorio + horarios fijos, control anti-baneo) descrito por el usuario.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SendMode {
  COPY_AS_OWN // "copiar como propio"
  FORWARD_NO_AUTHOR // "reenvio sin autor" (conserva emoji premium)
}

enum ScheduleMode {
  RANDOM // ciclo con pausas aleatorias + descansos por lote
  FIXED // tabla de horarios exactos por posicion
}

enum CampaignStatus {
  ACTIVE
  PAUSED
}

enum AccountHealth {
  OK
  PEER_FLOOD_PAUSED
  DISABLED
}

enum LogLevel {
  INFO
  SENT
  ERROR
  WAIT
  MISSED // "Horario perdido": un slot de horario fijo se paso sin enviar
}

model Account {
  id            String @id @default(cuid())
  label         String // nombre visible, ej "Zoweey"
  phoneNumber   String @unique
  sessionString String // sesion MTProto cifrada en reposo (ver ENCRYPTION.md)
  timezone      String @default("Europe/Madrid")

  // Interruptor maestro: "Encender/Apagar reenviador" de la cuenta.
  // Con esto en false, NINGUNA campaña de esta cuenta envia nada,
  // independientemente de su propio estado Activa/Pausada.
  reenviadorEnabled Boolean @default(false)

  health              AccountHealth @default(OK)
  peerFloodUntil      DateTime? // fin de la pausa por PeerFlood
  softStartCyclesLeft Int           @default(0) // ciclos restantes en arranque suave
  softStartMultiplier Float         @default(2)

  // Config global de proteccion anti-baneo para esta cuenta (aplica a
  // todas sus campañas, igual que "PeerFlood" en el panel de configuracion)
  peerFloodPauseMinutes  Int   @default(45)
  softStartCycles        Int   @default(2) // ciclos de arranque suave tras la pausa
  firstCycleSendCap      Int   @default(10) // tope de envios en el primer ciclo tras pausa
  firstCycleLinkFraction Float @default(0.3) // fraccion de envios con enlace permitidos en el primer ciclo

  // Cuanto puede retrasarse el envio de un horario fijo (por estar apagado,
  // pausado por PeerFlood, o el CRM reiniciandose) antes de darlo por
  // perdido en vez de mandarlo tarde. Igual al "tope" que viste en consola.
  missedSlotToleranceMinutes Int @default(60)

  // Numero de WhatsApp (E.164, ej +34600111222) al que avisar de pausas
  // por PeerFlood y otros eventos importantes. El envio real se hace via
  // Twilio (ver notifications.ts) con las credenciales globales del .env.
  notifyWhatsAppTo String?

  // "Precios" de Configuración → Modelos → esta creadora: texto libre para
  // que las chatters sepan a cuanto vender, igual que en el panel de referencia.
  pricesInfo String @default("")

  freeChannels FreeChannel[]

  // Carpetas de Telegram (ademas de los chats privados normales) que
  // tambien deben aparecer en el listado de "Mensajes", para poder entrar a
  // los grupos restringidos con clientes (u otras carpetas tipo "Posibles",
  // "Clientes"...) sin salir del panel. JSON string[] con el TITULO exacto
  // de la carpeta tal y como esta en Telegram.
  extraMessageFolders String @default("[]")

  // "Contenido" de la modelo: el grupo/canal con temas (sexting, lenceria,
  // fotos...) desde el que se envian packs a los fans en el apartado
  // Mensajes (boton de la carpeta junto al cuadro de texto).
  contentGroupChatId String?
  contentGroupTitle  String?

  // "Colorear por carpeta" en la vista "Todos los medios" de la bóveda:
  // solo guarda la preferencia, la pinta el frontend.
  contentColorByFolder Boolean @default(false)

  // "Bloqueo automático por país": prefijos de país (ver telegram/phoneCountry.ts)
  // cuyos fans se bloquean solos en Telegram nada mas escribir por chat
  // directo. JSON string[] con los prefijos (ej. ["1","7"]).
  blockedCountries String @default("[]")

  // "Excluir carpeta de Telegram": lo contrario de extraMessageFolders -
  // saca de la lista de "Mensajes" los chats de estas carpetas (ej equipo
  // interno que no son fans). Mismo formato: JSON string[] de titulos.
  excludedMessageFolders String @default("[]")

  // "Carpetas de Telegram → Sincronizar carpetas automáticamente": si esta
  // encendido, al ponerle una lista a un fan (Cliente, Grupo cliente,
  // Posibles, SFS, TW) se añade su chat a la carpeta de Telegram indicada
  // aqui para esa lista. folderSyncMap es JSON {"Cliente":"Clientes", ...}.
  autoSyncFoldersEnabled Boolean @default(false)
  folderSyncMap          String  @default("{}")

  // "Grupos restringidos → Cuenta ayudante": si Telegram rechaza crear el
  // grupo restringido desde esta cuenta (USER_RESTRICTED), se crea con la
  // cuenta elegida aqui en su lugar, dejando a esta cuenta como admin.
  restrictedGroupHelperAccountId String?

  quickReplies QuickReply[]
  sfsPackages  SfsPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceGroups      SourceGroup[]
  campaigns         Campaign[]
  logs              SendLog[]
  accountNote       AccountNote?
  fanNotes          FanNote[]
  fanSales          FanSale[]
  scripts           Script[]
  emojiPacks        AccountEmojiPack[]
  contentFavorites  ContentFavorite[]
  contentNotes      ContentNote[]
  contentSendLogs   ContentSendLog[]
  restrictedGroups  ClientRestrictedGroup[]
  workerPermissions WorkerPermission[]
}

// "Equipo": trabajadores con su propio login (sin necesitar el numero de
// telefono/sesion de la modelo). role "admin" ve y gestiona todo (la propia
// agencia); role "worker" solo ve, cuenta por cuenta y apartado por
// apartado, lo que se le conceda explicitamente en WorkerPermission.
model Worker {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("worker") // "admin" | "worker"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // "Trabajo remoto" (Configuración → Empleados, como en TeleCrew): de
  // momento es solo informativo -no hay todavia una app de escritorio
  // separada del panel web, asi que no restringe nada por si solo-, pero
  // se guarda ya para cuando exista esa distincion.
  canUseBrowser Boolean @default(true)

  // "Días y modelos": que cuentas le tocan a este trabajador cada dia de la
  // semana, solo como aviso (no quita acceso). JSON tipo
  // {"lunes":["accId1","accId2"], "martes":[...], ...}. Vacio = nunca avisa.
  scheduleJson String @default("{}")

  // "Excepciones puntuales para este empleado" (como en TeleCrew): permisos
  // finos ademas de Mensajes/SFS. JSON tipo {"vaultScreenshots":false,
  // "scheduleContent":false,"quickReplies":false,"sfsPackages":false,
  // "scripts":false}. Se guardan ya, aunque todavia no bloquean nada en el
  // resto de rutas -eso queda para la siguiente ronda-.
  extraPermissionsJson String @default("{}")

  permissions WorkerPermission[]
}

// Un permiso = esta cuenta (modelo) + este apartado, concedido a este
// trabajador. section: "mensajes" | "mensajes-pro" | "sfs" (los tres
// apartados a los que un trabajador puede llegar a tener acceso).
model WorkerPermission {
  id        String   @id @default(cuid())
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  section   String
  createdAt DateTime @default(now())

  @@unique([workerId, accountId, section])
}

// "Respuestas rápidas" de Configuración → Modelos → esta creadora: textos
// hechos para que las chatters los manden con un clic desde el chat.
model QuickReply {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

// "SFS (intercambios con otras modelos)": paquetes listos (medios de la
// bóveda de esta cuenta + texto) que las chatters mandan con un clic al
// pactar una promo cruzada con otra modelo. mediaRefs es JSON con los
// mensajes elegidos de la bóveda: [{"id":"123","caption":"...","type":"photo"}].
model SfsPackage {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  mediaRefs   String   @default("[]")
  captionText String   @default("")
  createdAt   DateTime @default(now())
}

// "Emoji premium" de una cuenta: sets de emoji animados de Telegram
// (t.me/addemoji/<shortName>) enlazados a esta modelo, para poder
// insertarlos en el chat igual que en el panel de referencia. Maximo 5
// packs por cuenta (limite aplicado en la API).
model AccountEmojiPack {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shortName String // nombre corto del set, ej "paintown" en t.me/addemoji/paintown
  title     String?
  createdAt DateTime @default(now())

  @@unique([accountId, shortName])
}

// "Notas de la modelo": info general de la cuenta (una por cuenta), tal y
// como se ve en el apartado "Mensajes" del panel de referencia.
model AccountNote {
  accountId String   @id
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  info      String   @default("")
  updatedAt DateTime @updatedAt
}

// "Notas del fan": una nota por conversacion (cuenta + chat de Telegram),
// con lista/etiqueta (ej "Cliente") y notas libres. Las ventas van aparte,
// en FanSale, para poder llevar un historial (no solo un importe suelto).
model FanNote {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId    String // id de Telegram del chat/usuario (el "fan")
  chatTitle String? // nombre visible en el momento de guardar, por si cambia
  list      String? // etiqueta rapida, ej "Cliente", "Prioridad"
  note      String  @default("")

  // "Bloqueo automático por país": si este fan fue bloqueado solo porque
  // escribio desde un pais de la lista negra, y si despues se desbloqueo a
  // mano (para no volver a bloquearlo nunca mas automaticamente).
  autoBlockedByCountry Boolean @default(false)
  manuallyUnblocked    Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@unique([accountId, chatId])
}

// Historial de ventas realizadas a un fan concreto (cuenta + chat), tal y
// como se ve en el apartado "Vendido a este fan" del panel de referencia.
model FanSale {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId        String // id de Telegram del chat/usuario (el "fan")
  amount        Float
  date          DateTime
  service       String? // ej "Pack de fotos", "Videollamada"
  paymentMethod String? // ej "Transferencia", "Tarjeta", "Crypto", "OnlyFans"
  soldBy        String? // quien hizo la venta (empleada/o)
  detail        String?
  paymentRef    String? // referencia/nota del pago adjuntado
  createdAt     DateTime @default(now())

  @@index([accountId, chatId])
}

// Contenido de la bóveda marcado como favorito (por cuenta + tema + mensaje
// de Telegram), para el apartado de "Favoritos" del selector de contenido.
model ContentFavorite {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  topicId   String // id del tema del grupo de contenido al que pertenece
  messageId String // id del mensaje de Telegram (raiz del album si aplica)
  createdAt DateTime @default(now())

  @@unique([accountId, messageId])
}

// Nota interna (solo la ve el equipo, nunca el fan) sobre un contenido
// concreto de la bóveda: un resumen de lo que se ve/dice en la foto, vídeo o
// audio, para no tener que reproducirlo entero cada vez para saber qué es.
model ContentNote {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messageId String // id del mensaje de Telegram (raiz del album si aplica)
  note      String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([accountId, messageId])
}

// Registro de que un mensaje enviado a un fan concreto vino "de la bóveda"
// (contenido de la modelo, enviado normal o "ver una vez"). Sirve solo para
// poder marcar esos medios con la etiqueta "GRUPO" dentro de la Galería del
// chat; no guarda el contenido en si, solo el id del mensaje resultante.
model ContentSendLog {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId            String // chat del fan al que se envio
  telegramMessageId String // id del mensaje ya en el chat del fan
  createdAt         DateTime @default(now())

  @@unique([accountId, chatId, telegramMessageId])
  @@index([accountId, chatId])
}

// Grupo restringido (solo modelo + un cliente concreto, con "restringir
// guardar contenido" activado en Telegram) para servicios de pago que no se
// pueden hacer desde el chat privado normal. Uno por cuenta + fan.
model ClientRestrictedGroup {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId      String // chat privado del fan (1:1) al que pertenece este grupo
  groupChatId String // id de Telegram del grupo restringido ya creado
  groupTitle  String?
  createdAt   DateTime @default(now())

  @@unique([accountId, chatId])
}

// Canal de Telegram (con solicitud de union) de una creadora, para el
// apartado "Canales free": aqui se listan las solicitudes pendientes de ese
// canal y se pueden aceptar/rechazar sin salir del panel.
model FreeChannel {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId    String // id de Telegram del canal
  title     String
  createdAt DateTime @default(now())

  @@unique([accountId, chatId])
}

// "Scripts": mensajes guardados para insertar rapido en la conversacion con
// un fan (respuestas frecuentes, precios, guiones de venta...), por cuenta.
model Script {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title     String
  content   String
  position  Int      @default(0) // orden de aparicion
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ajustes generales de TODA la agencia (una unica fila), tal y como se ven
// en Configuración → General → "Toda la agencia" del panel de referencia:
// listas de servicios/métodos de pago al apuntar una venta, verificación de
// ventas y la etiqueta de "comprador reciente".
model AgencySettings {
  id                   String   @id @default("singleton")
  services             String   @default("[]") // JSON string[] — chips de "Servicio" al apuntar una venta
  paymentMethods       String   @default("[]") // JSON string[] — chips de "Método de pago" al apuntar una venta
  saleVerificationMode String   @default("disabled") // "disabled" | "connected_only" | "all"
  recentBuyerEnabled   Boolean  @default(true)
  recentBuyerMode      String   @default("each") // "each" (cada compra) | "first" (solo la primera)
  recentBuyerDays      Int      @default(7)
  updatedAt            DateTime @updatedAt
}

model SourceGroup {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  title       String // titulo exacto del chat/grupo origen en Telegram
  topicName   String? // nombre del tema/topic dentro del grupo, si aplica
  chatId      String // id numerico de Telegram del chat origen
  topicId     Int? // id del topic (foro) si aplica
  recentLimit Int     @default(25) // cuantos mensajes recientes se consideran

  campaigns Campaign[]

  @@unique([accountId, chatId, topicId])
}

model Campaign {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  sourceGroupId String
  sourceGroup   SourceGroup @relation(fields: [sourceGroupId], references: [id])

  folderName String // nombre de la carpeta de Telegram (agrupa los chats destino)
  status     CampaignStatus @default(ACTIVE)

  sendMode        SendMode @default(FORWARD_NO_AUTHOR)
  sendAlbums      Boolean  @default(true)
  textOnlyAllowed Boolean  @default(false)

  scheduleMode ScheduleMode @default(RANDOM)

  // --- parametros modo RANDOM ---
  cycleSeconds        Int    @default(2700) // 45 min por defecto
  minGapSeconds       Int    @default(2)
  maxGapSeconds       Int    @default(7)
  batchSize           Int    @default(60)
  batchRestMinSeconds Int    @default(30)
  batchRestMaxSeconds Int    @default(60)
  activeFrom          String @default("00:00") // HH:mm en timezone de la cuenta
  activeTo            String @default("23:59")

  // anti-duplicado: no repetir destino hasta que haya N mensajes ajenos de por medio
  minForeignMessagesBeforeRepeat Int @default(0)

  destinationChats CampaignDestination[]
  scheduleSlots    ScheduleSlot[]
  logs             SendLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampaignDestination {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  chatId    String // id de Telegram del grupo/canal destino
  chatTitle String
  topicId   Int? // si el destino es un foro con temas

  @@unique([campaignId, chatId, topicId])
}

// Solo se usa cuando Campaign.scheduleMode == FIXED
model ScheduleSlot {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  timeOfDay String // "HH:mm" en timezone de la cuenta
  position  Int // posicion entre los mensajes recientes del origen (1 = mas nuevo)
  active    Boolean @default(true)

  runs ScheduleSlotRun[]

  @@unique([campaignId, timeOfDay])
}

// Un registro por slot y por dia (fecha en la timezone de la cuenta): evita
// que el mismo horario se procese dos veces y es lo que permite distinguir
// "ya enviado hoy" de "hoy tocaba y no se ha enviado todavia".
model ScheduleSlotRun {
  id             String       @id @default(cuid())
  scheduleSlotId String
  scheduleSlot   ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Cascade)

  runDate String // "YYYY-MM-DD" en timezone de la cuenta
  status  String // "SENT" | "MISSED"

  createdAt DateTime @default(now())

  @@unique([scheduleSlotId, runDate])
}

model SendLog {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  level     LogLevel
  chatTitle String?
  message   String // texto descriptivo, ej "Chat: XHUB ESPAÑOLAS | mensaje origen 860"
  errorCode String?

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([campaignId, createdAt])
}
