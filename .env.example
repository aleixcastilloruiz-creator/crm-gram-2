# Copia este archivo a .env y rellena los valores

# Credenciales de API de Telegram (se obtienen en https://my.telegram.org -> API development tools)
# Son las credenciales de TU aplicacion, no de una cuenta de usuario concreta.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Conexion a Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/lureqo_crm?schema=public"

# Clave usada para cifrar los session strings de Telegram en reposo (32 bytes en base64)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=

# Puerto del servidor HTTP interno
PORT=4000

# Avisos por WhatsApp (Twilio) - ver src/utils/notifications.ts para el setup paso a paso
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
