{
  "name": "luxe-crm-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de reenvio/scheduler para LUXE FAN MANAGEMENT - CRM Telegram",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "login:account": "ts-node-dev --transpile-only src/telegram/loginCli.ts",
    "login:account:prod": "node dist/telegram/loginCli.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "input": "^1.0.1",
    "telegram": "^2.26.16",
    "prisma": "^5.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
